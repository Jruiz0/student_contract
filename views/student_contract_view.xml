<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">Contract Form</field>
        <field name="model">student.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                        <button name="action_generate_dashboard" type="object" string="Generar Enlace" class="btn-primary"/>
                        <button name="action_draft" type="object" string="Borrar" class="btn-primary" invisible="state != 'confirmed'"/>
                        <button name="action_confirm" type="object" string="Confirmar" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_cancel" type="object" string="Cancelar" class="btn-primary" invisible="state not in ('draft', 'confirmed')"/>s
                        <button name="register_payment_action"  type="object" string="Registrar Pago" class="btn-primary" invisible="state != 'confirmed'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-bars" invisible="payment_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="payment_count"/></span>
                                <span class="o_stat_text">Payments</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="period_id"  options="{'no_create': True}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="total_amount" readonly="1"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="balance_due" readonly="1"/>
                            <field name="journal_id"/>
                        </group>
                        <field name="url" readonly="1"/>
                        <field name="payment_count" invisible="1"/>
                        <field name="selected_subject_ids" widget="many2many_tags" invisible="1"/>
                    </group>
                    <notebook>
                        <page name="name" string="Contract Lines">
                            <field name="line_ids">
                                <form>
                                    <group>
                                        <field name="student_id" readonly="1"/>
                                        <field name="subject_id" options="{'no_create': True}"/>
                                        <field name="teacher_id" options="{'no_create': True}"/>
                                        <field name="price"/>
                                        <field name="contract_id" invisible="1"/>
                                        <field name="teacher_ids" invisible="1"/>
                                        <field name="subject_ids" invisible="1"/>
                                        <field name="selected_subject_ids" invisible="1"/>
                                    </group>
                                </form>
                                <tree editable="bottom">
                                    <field name="subject_id" options="{'no_create': True}"/>
                                    <field name="teacher_id" options="{'no_create': True}"/>
                                    <field name="price"/>
                                    <field name="contract_id" invisible="1" optional="hide"/>
                                    <field name="selected_subject_ids" invisible="1" optional="hide"/>
                                    <field name="subject_ids" invisible="1" optional="hide"/>
                                    <field name="teacher_ids" invisible="1" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="student_contract_view_tree" model="ir.ui.view">
        <field name="name">student.contract.tree</field>
        <field name="model">student.contract</field>
        <field name="arch" type="xml">
            <tree string="Student Contract">
                <field name="student_id"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>
        
    <record id="student_contract_view_search" model="ir.ui.view">
        <field name="name">student.contract.search</field>
        <field name="model">student.contract</field>
        <field name="arch" type="xml">
            <search string="Student Contract">
                <field name="student_id"/>
            </search>
        </field>
    </record>

    <record id="action_student_contract" model="ir.actions.act_window">
        <field name="name">Student Contracts</field>
        <field name="res_model">student.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>